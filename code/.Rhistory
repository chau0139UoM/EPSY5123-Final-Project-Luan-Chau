belief_change <- chatbot_long %>%
select(ParticipantNo, SelectedStyle, Misconception, Time, BeliefRating) %>%
group_by(ParticipantNo, SelectedStyle, Misconception, Time) %>%
summarise(
BeliefRating = mean(BeliefRating, na.rm = TRUE),
.groups = "drop"
) %>%
pivot_wider(
names_from = Time,
values_from = BeliefRating
) %>%
mutate(
BeliefReduction = Pre - Post
)
