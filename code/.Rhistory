chatbot_long %>%
group_by(SelectedStyle, Time) %>%
summarise(
MeanBelief = mean(BeliefRating, na.rm = TRUE),
SDBelief = sd(BeliefRating, na.rm = TRUE),
N = n(),
.groups = "drop"
)
chatbot_long %>%
filter(!is.na(SelectedStyle)) %>%
group_by(SelectedStyle, Time) %>%
summarise(
MeanBelief = mean(BeliefRating, na.rm = TRUE),
SDBelief = sd(BeliefRating, na.rm = TRUE),
N = n(),
.groups = "drop"
)
chatbot_long %>%
filter(!is.na(SelectedStyle)) %>%
group_by(SelectedStyle, Time) %>%
summarise(
MeanBelief = mean(BeliefRating, na.rm = TRUE),
SDBelief = sd(BeliefRating, na.rm = TRUE),
N = n(),
.groups = "drop"
)
chatbot_long %>%
filter(!is.na(SelectedStyle)) %>%
group_by(SelectedStyle, Time) %>%
summarise(
MeanBelief = mean(BeliefRating, na.rm = TRUE),
SDBelief = sd(BeliefRating, na.rm = TRUE),
N = n(),
.groups = "drop"
) %>%
arrange(SelectedStyle, desc(Time))
chatbot_long %>%
filter(!is.na(SelectedStyle)) %>%
group_by(SelectedStyle, Misconception, Time) %>%
summarise(
MeanBelief = mean(BeliefRating, na.rm = TRUE),
SDBelief = sd(BeliefRating, na.rm = TRUE),
N = n(),
.groups = "drop"
) %>%
arrange(SelectedStyle, Misconception, desc(Time))
chatbot_long %>%
count(ParticipantNo, SelectedStyle, Misconception, Time) %>%
filter(n > 1)
ggplot(
chatbot_long %>%
filter(SelectedStyle != "control"),
aes(x = Time,
y = BeliefRating,
group = SelectedStyle,
color = SelectedStyle)
) +
stat_summary(fun = mean, geom = "line", linewidth = 1) +
stat_summary(fun = mean, geom = "point", size = 3) +
stat_summary(fun.data = mean_se,
geom = "errorbar",
width = .10) +
facet_wrap(~ Misconception) +
labs(
title = "Belief Revision Across Misconceptions",
x = "Time",
y = "Belief Rating",
color = "Chatbot Condition"
) +
theme_minimal()
ggplot(
chatbot_long %>%
filter(SelectedStyle != "control") %>%
mutate(
Time = factor(Time, levels = c("Pre", "Post"))
),
aes(x = Time,
y = BeliefRating,
group = SelectedStyle,
color = SelectedStyle)
) +
stat_summary(fun = mean, geom = "line", linewidth = 1) +
stat_summary(fun = mean, geom = "point", size = 3) +
stat_summary(fun.data = mean_se,
geom = "errorbar",
width = .10) +
facet_wrap(~ Misconception) +
labs(
title = "Belief Revision Across Misconceptions",
